# Copie para .env e troque o segredo por um texto longo qualquer.
PORT=3000
JWT_SECRET=troque-este-segredo-por-um-texto-longo-e-aleatorio
JWT_EXPIRES=8h

# Banco. Com `docker compose up` o host vira "banco"; rodando o Node fora do
# Docker, o MySQL do contêiner é alcançado em localhost:3306.
DB_HOST=localhost
DB_PORT=3306
DB_USER=cursos
DB_PASSWORD=cursos
DB_NAME=plataforma_cursos
